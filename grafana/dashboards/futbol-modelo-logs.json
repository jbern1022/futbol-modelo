{
  "title": "futbol-modelo: Logs",
  "uid": "futbol-modelo-logs",
  "tags": ["futbol-modelo", "loki"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job_name",
        "type": "query",
        "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
        "query": "label_values({namespace=\"default\"}, job_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by job",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (job_name) (count_over_time({namespace=\"default\", job_name=~\"$job_name\"} [$__interval]))",
          "legendFormat": "{{job_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Errors and warnings by job",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (job_name, level) (count_over_time({namespace=\"default\", job_name=~\"$job_name\", level=~\"WARNING|ERROR\"} [$__interval]))",
          "legendFormat": "{{job_name}} ({{level}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Recent errors and warnings",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{namespace=\"default\", job_name=~\"$job_name\", level=~\"WARNING|ERROR\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "All logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 26 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{namespace=\"default\", job_name=~\"$job_name\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
