FROM python:3.12-slim
WORKDIR /app
RUN useradd -r -M -d /app appuser
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY --chown=appuser:appuser api/ api/
# Only ops/ (not the rest of src/) -- json_logging.py is stdlib-only,
# doesn't need this image's dependency set widened. See
# src/ops/json_logging.py's docstring.
COPY --chown=appuser:appuser src/ops/ src/ops/
ENV PYTHONPATH=/app/src
EXPOSE 8000
USER appuser
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
