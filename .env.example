# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Postgres connection string for the ingestion/grading pipeline (read-write role).
FUTBOL_DSN="host=CHANGE_ME dbname=futbol user=futbol password=CHANGE_ME"

# API-Football key (https://www.api-football.com/).
API_FOOTBALL_KEY="CHANGE_ME"

# Read-only DSN used by the API. The futbol_ro role has SELECT only, so the
# API cannot write to the prediction ledger even in the event of a bug.
FUTBOL_RO_DSN="host=CHANGE_ME dbname=futbol user=futbol_ro password=CHANGE_ME"

# Ollama endpoint backing Petey.
FUTBOL_OLLAMA_URL="http://CHANGE_ME:11434"
